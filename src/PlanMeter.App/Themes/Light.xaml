<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- PlanMeter B light tokens. Merged by Generic.xaml (no x:Key). Key names are
         the existing Brush.* set plus the new Brush.QuotaTrack.
         Do not rename any key (T-13-01). -->
    <SolidColorBrush x:Key="Brush.Surface" Color="#F8FAF9" />
    <SolidColorBrush x:Key="Brush.Surface.Elevated" Color="#EEF2EF" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#23764B" />
    <SolidColorBrush x:Key="Brush.NearLimit" Color="#99630A" />
    <SolidColorBrush x:Key="Brush.Error" Color="#B3261E" />
    <SolidColorBrush x:Key="Brush.OnSurface" Color="#25332B" />
    <SolidColorBrush x:Key="Brush.OnSurface.Dimmed" Color="#647268" />
    <SolidColorBrush x:Key="Brush.Dimmed" Color="#87948B" />
    <SolidColorBrush x:Key="Brush.Divider" Color="#DBE4DE" />
    <SolidColorBrush x:Key="Brush.QuotaTrack" Color="#E1E9E4" />
    <SolidColorBrush x:Key="Brush.FocusRing" Color="#23764B" Opacity="0.6" />

</ResourceDictionary>
