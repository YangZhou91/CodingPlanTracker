<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Spacing Scale (UI-SPEC §Spacing Scale). All values DIP at 96 DPI baseline. -->
    <sys:Double x:Key="Space.Xs">4</sys:Double>
    <sys:Double x:Key="Space.Sm">8</sys:Double>
    <sys:Double x:Key="Space.Md">12</sys:Double>
    <sys:Double x:Key="Space.Lg">16</sys:Double>
    <sys:Double x:Key="Space.Xl">24</sys:Double>
    <!-- Space.3Xl = 48 — the Phase-3 section break between the Providers group and the
         Polling group in the settings window (the exact reserved-token use named in
         Phase 1; 03-UI-SPEC Spacing). Consumed in 03-04. -->
    <sys:Double x:Key="Space.3Xl">48</sys:Double>
    <sys:Double x:Key="Space.Touch">44</sys:Double>

    <!-- Typography (UI-SPEC §Typography). -->
    <FontFamily x:Key="FontFamily.App">Segoe UI Variable Text, Segoe UI</FontFamily>
    <sys:Double x:Key="Text.Display.Size">20</sys:Double>
    <sys:Double x:Key="Text.Body.Size">13</sys:Double>
    <sys:Double x:Key="Text.Label.Size">11</sys:Double>

    <!-- Color brushes (UI-SPEC §Color) — Light/Dark pairs. Phase-1 minimal viable
         swap: the app renders with the LIGHT pair by default. Plan 01-02 wires the
         ThemeDictionary/ResourceDictionary swap keyed off SystemParameters. -->
    <SolidColorBrush x:Key="Brush.Surface" Color="#F5F5F5" />
    <SolidColorBrush x:Key="Brush.Surface.Elevated" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#0E7A4A" />
    <SolidColorBrush x:Key="Brush.NearLimit" Color="#C47A00" />
    <SolidColorBrush x:Key="Brush.Error" Color="#B3261E" />
    <SolidColorBrush x:Key="Brush.OnSurface" Color="#1A1A1A" />
    <SolidColorBrush x:Key="Brush.OnSurface.Dimmed" Color="#5A5A5A" />
    <SolidColorBrush x:Key="Brush.Dimmed" Color="#8A8A8A" />
    <SolidColorBrush x:Key="Brush.Divider" Color="#E0E0E0" />
    <SolidColorBrush x:Key="Brush.FocusRing" Color="#0E7A4A" Opacity="0.6" />

    <!-- Convenience styles -->
    <Style x:Key="TextDisplayStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.App}" />
        <Setter Property="FontSize" Value="{StaticResource Text.Display.Size}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="TextBodyStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.App}" />
        <Setter Property="FontSize" Value="{StaticResource Text.Body.Size}" />
        <Setter Property="FontWeight" Value="Regular" />
    </Style>

    <Style x:Key="TextLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.App}" />
        <Setter Property="FontSize" Value="{StaticResource Text.Label.Size}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- State badges (STALE / ERROR / NO KEY / RE-LOGIN / UNSUPPORTED) — Label-size,
         OnSurface.Dimmed, 1 DIP border. Same shell for every badge. -->
    <Style x:Key="StateBadgeStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Divider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Padding" Value="4,1" />
        <Setter Property="Margin" Value="0,0,0,0" />
    </Style>

    <!-- ProviderToggle (03-UI-SPEC §Enable/disable toggle) — a native ToggleButton with a
         hand-authored ControlTemplate (NO third-party pack): 40×20 DIP track, 16×16 DIP
         thumb. OFF = Brush.Surface.Elevated + 1 DIP Brush.Divider border + OnSurface.Dimmed
         thumb; ON (IsChecked) = Brush.Accent track + white thumb (Accent-reserved item #4);
         hover = Brush.OnSurface.Dimmed track border (both states, quiet — no Accent spill);
         disabled = 50% opacity. ALL color bindings via DynamicResource (high-contrast
         deferral). Reduced motion (SystemParameters.ClientAreaAnimation == false): the thumb
         SNAPS (an alignment-based MultiDataTrigger; no animation runs in that mode). With
         animations on, the thumb SLIDES via a storyboard-animated RenderTransform translate.
         The two position mechanisms are mutually exclusive (never both active). -->
    <Style x:Key="ProviderToggle" TargetType="ToggleButton">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="20" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle">
            <Setter.Value>
                <Style>
                    <Setter Property="Control.Template">
                        <Setter.Value>
                            <ControlTemplate>
                                <Rectangle RadiusX="2" RadiusY="2" StrokeThickness="1"
                                           Stroke="{DynamicResource Brush.FocusRing}"
                                           StrokeDashArray="1 2" Margin="-2" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Width="40" Height="20">
                        <!-- Track: 40×20 pill (CornerRadius = half the height). -->
                        <Border x:Name="Track"
                                Background="{DynamicResource Brush.Surface.Elevated}"
                                BorderBrush="{DynamicResource Brush.Divider}"
                                BorderThickness="1"
                                CornerRadius="10" />
                        <!-- Thumb: 16×16 circle, inset 2 DIP from the left edge at rest.
                             Position has TWO sources that are NEVER both active (a Setter
                             cannot use a chained (Type.Prop).(Type.Prop) path — MC4106 — and
                             a Freezable's name is not a Trigger target — MC4111 — so the
                             snap uses pure Ellipse DPs while the slide uses a storyboard):
                               • Reduced motion (ClientAreaAnimation == False) → the thumb
                                 SNAPS via HorizontalAlignment/Margin (see the MultiDataTrigger
                                 below); no animation runs in this mode.
                               • Animations on (ClientAreaAnimation == True) → the thumb
                                 SLIDES via the storyboard-animated RenderTransform translate
                                 (X = 0 off / 20 on = 40 − 16 − 2·2 insets). -->
                        <Ellipse x:Name="Thumb"
                                 Width="16" Height="16"
                                 Fill="{DynamicResource Brush.OnSurface.Dimmed}"
                                 HorizontalAlignment="Left"
                                 Margin="2,0,0,0"
                                 VerticalAlignment="Center"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <TranslateTransform X="0" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- ON state colors: Accent track + white thumb (Accent-reserved
                             item #4). Position is handled by the mode-specific triggers below,
                             NOT here (no chained-path Setter). -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Thumb" Property="Fill" Value="White" />
                        </Trigger>
                        <!-- Hover: quiet border emphasis in BOTH states (no Accent spill). -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.OnSurface.Dimmed}" />
                        </Trigger>
                        <!-- Disabled: standard 50% opacity de-emphasis. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                        <!-- REDUCED-MOTION SNAP (ClientAreaAnimation == False): the ON thumb
                             snaps to the right edge via pure Ellipse DPs (Setter-compatible).
                             The OFF position is the template base (Left + 2 inset), so the
                             snap-back needs no explicit trigger. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsChecked}" Value="True" />
                                <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0" />
                        </MultiDataTrigger>
                        <!-- SMOOTH SLIDE (ClientAreaAnimation == True): the ON/OFF thumb slides
                             via the storyboard-animated RenderTransform translate. Storyboards
                             DO support the chained property path a Setter cannot. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsChecked}" Value="True" />
                                <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard x:Name="ThumbSlideOn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="20" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsChecked}" Value="False" />
                                <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard x:Name="ThumbSlideOff">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
