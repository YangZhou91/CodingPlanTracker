<UserControl x:Class="PlanMeter.App.ProviderRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="279">

    <!-- D-23 / LAY-03 — the PlanMeter B single-row chrome. Fixed 26 DIP height
         includes the 1 DIP bottom stroke (last row thickness 0). Widths cite
         WidgetLayout.* (Core.Presentation); a later x:Static pass can bind them.
         Phase 14: BottomDivider hosts RowOuter directly — no vertical StackPanel,
         no under-row StateBadge. Every state is a single-line content swap. -->
    <Border x:Name="BottomDivider"
            Height="26"
            BorderBrush="{DynamicResource Brush.Divider}"
            BorderThickness="0,0,0,0">

        <!-- ROW (outer Grid). Columns: DragRegion 196 | gap 6 | Chip 45 | gap 6 | Reset 26
             = 279 content. Name 56 | Bar 64 | Remaining 64 inside DragRegion.
             Chip and timestamp live OUTSIDE DragRegion so clicks never start a drag. -->
        <Grid x:Name="RowOuter">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="196" />
                <ColumnDefinition Width="45" />
                <ColumnDefinition Width="26" />
            </Grid.ColumnDefinitions>

            <!-- DRAG region: Name 56 | Bar 64 | Remaining 64 = 196. -->
            <Grid x:Name="DragRegion"
                  Grid.Column="0"
                  Background="Transparent"
                  Cursor="SizeAll"
                  MouseLeftButtonDown="DragRegion_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="64" />
                </Grid.ColumnDefinitions>

                <!-- Provider name + the persistent qualifier badge (F1/UI-SPEC).
                     Badge Visibility + Text come from the adapter manifest
                     QualifierText (code-behind), NOT from a render state. -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="ProviderText"
                               Text="Z.ai"
                               FontSize="{StaticResource Text.Name.Size}"
                               FontWeight="Regular"
                               FontFamily="{StaticResource FontFamily.App}"
                               Foreground="{DynamicResource Brush.OnSurface}"
                               VerticalAlignment="Center"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               AutomationProperties.Name="Z.ai" />
                    <Border x:Name="QualifierBadge"
                            Style="{StaticResource StateBadgeStyle}"
                            Background="{DynamicResource Brush.Surface.Elevated}"
                            BorderBrush="{DynamicResource Brush.Divider}"
                            VerticalAlignment="Center"
                            Margin="4,0,0,0"
                            Visibility="Collapsed"
                            AutomationProperties.Name="Estimated figure">
                        <TextBlock x:Name="QualifierBadgeText"
                                   Text="ESTIMATED"
                                   Style="{StaticResource TextMutedStyle}"
                                   Foreground="{DynamicResource Brush.OnSurface.Dimmed}" />
                    </Border>
                </StackPanel>

                <!-- Bar cell (applied 64 DIP, WidgetLayout.BarW). Hosts ONLY QuotaBar
                     for Ok/NearLimit/Stale figure states. No FigureText, no
                     LoadingProgress, no LoadingGlyph — Phase 14 deletes them. -->
                <Grid Grid.Column="1"
                      Margin="6,0,0,0"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Left">
                    <!-- UIR-01 remaining-quota meter. Height 4 / CornerRadius 3
                         (WidgetLayout.BarHeight / BarRadius). Fixed 64 DIP track,
                         left-aligned so meters line up across rows. -->
                    <Grid x:Name="QuotaBar"
                          Width="64"
                          Height="4"
                          Visibility="Collapsed"
                          Cursor="Arrow"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="QuotaFillCol" Width="0*" />
                            <ColumnDefinition x:Name="QuotaEmptyCol" Width="100*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="QuotaTrack"
                                Grid.ColumnSpan="2"
                                Height="4"
                                Background="{DynamicResource Brush.QuotaTrack}"
                                CornerRadius="3" />
                        <Border x:Name="QuotaFill"
                                Grid.Column="0"
                                Height="4"
                                Background="{DynamicResource Brush.Accent}"
                                CornerRadius="3" />
                    </Grid>
                </Grid>

                <!-- Remaining label — left-aligned right after the quota bar. -->
                <StackPanel x:Name="RemainingHost"
                            Grid.Column="2"
                            Margin="6,0,0,0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock x:Name="RemainingPrefix"
                               Text="剩余"
                               Style="{StaticResource TextMutedStyle}"
                               Foreground="{DynamicResource Brush.OnSurface.Dimmed}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="RemainingValue"
                               Text="100%"
                               Margin="2,0,0,0"
                               FontSize="{StaticResource Text.Percent.Size}"
                               FontWeight="Medium"
                               FontFamily="{StaticResource FontFamily.App}"
                               Foreground="{DynamicResource Brush.OnSurface}"
                               Typography.NumeralAlignment="Tabular"
                               TextWrapping="NoWrap"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- StatusText — Phase 14 ROW-04..09 body line. Spans bar+remaining
                     (DragRegion cols 1-2), left-aligned after the name, muted. -->
                <TextBlock x:Name="StatusText"
                           Grid.Column="1"
                           Grid.ColumnSpan="2"
                           Margin="6,0,0,0"
                           Text=""
                           Style="{StaticResource TextMutedStyle}"
                           Foreground="{DynamicResource Brush.OnSurface.Dimmed}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           Cursor="Arrow"
                           Visibility="Collapsed"
                           AutomationProperties.LiveSetting="Polite" />
            </Grid>

            <!-- Window-type chip (outside DragRegion — clicking the chip never drags).
                 Fill-only (no border), radius 3, padding 3,1 so WEEK/MONTH fit the
                 applied 45 DIP column (WidgetLayout.ChipW, font-measure steal 8).
                 DATA-02/all-windows-tooltip — ToolTip is set imperatively from Render. -->
            <Border x:Name="ChipBorder"
                    Grid.Column="1"
                    Margin="6,0,0,0"
                    Background="{DynamicResource Brush.Surface.Elevated}"
                    CornerRadius="3"
                    Padding="3,1"
                    Visibility="Collapsed"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Cursor="Arrow">
                <TextBlock x:Name="ChipText"
                           Text="5H"
                           Style="{StaticResource TextMutedStyle}"
                           Foreground="{DynamicResource Brush.OnSurface.Dimmed}"
                           HorizontalAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
            </Border>

            <!-- Timestamp (outside DragRegion — clicking the timestamp never drags).
                 Applied 26 DIP reset column (WidgetLayout.ResetW) so "now"/"6d" fit. -->
            <TextBlock x:Name="TimestampText"
                       Grid.Column="2"
                       Margin="6,0,0,0"
                       Text=""
                       Style="{StaticResource TextMutedStyle}"
                       Foreground="{DynamicResource Brush.OnSurface.Dimmed}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       Visibility="Collapsed" />
        </Grid>
    </Border>
</UserControl>
