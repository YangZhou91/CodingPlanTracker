<UserControl x:Class="PlanMeter.App.ProviderRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="240">

    <!-- D-23 — the Phase-1 row chrome, extracted UNCHANGED into a reusable user control
         (not redesigned). MainWindow stacks one ProviderRow per registered provider in
         registry order. The row renders ONLY its own store slot (PROV-02/row-isolation). -->
    <Border x:Name="BottomDivider"
            BorderBrush="{DynamicResource Brush.Divider}"
            BorderThickness="0,0,0,0">
        <StackPanel Orientation="Vertical">

            <!-- ROW (outer Grid). DragRegion = provider + figure area only; chip and
                 timestamp live OUTSIDE DragRegion so clicks there never initiate a drag.
                 Phase 3 (03-03): the per-row hover affordance + mini-menu are RETIRED —
                 rows are display-only; key management lives in the settings window (D-01). -->
            <Grid x:Name="RowOuter">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="WindowChip" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ResetTime" />
                </Grid.ColumnDefinitions>

                <!-- DRAG region: provider-name + figure area. DragMove fires ONLY from
                     here (WIDGET-02/drag; UI-SPEC §Drag region). The widget-global
                     right-click menu (Refresh now / About / Settings… / Quit) is attached
                     by MainWindow per row (code-built, handlers on MainWindow) so
                     right-click on any row's drag region opens it. -->
                <Grid x:Name="DragRegion"
                      Grid.Column="0"
                      Background="Transparent"
                      Cursor="SizeAll"
                      MouseLeftButtonDown="DragRegion_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="ProviderName" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Provider name + the persistent qualifier badge (F1/UI-SPEC — the
                         generalized Demo-badge slot). The badge sits immediately to the
                         right of the provider name; its Visibility + Text come from the
                         adapter manifest's QualifierText (set in code-behind), NOT from a
                         render state — it persists across loading / ok / error, the
                         constant disambiguator (e.g. ESTIMATED for a header-derived figure).
                         The badge sits OUTSIDE DragRegion's hit-target contract. -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0">
                        <TextBlock x:Name="ProviderText"
                                   Text="Z.ai"
                                   Style="{StaticResource TextBodyStyle}"
                                   Foreground="{DynamicResource Brush.OnSurface}"
                                   VerticalAlignment="Center"
                                   TextWrapping="NoWrap"
                                   AutomationProperties.Name="Z.ai" />
                        <Border x:Name="QualifierBadge"
                                Style="{StaticResource StateBadgeStyle}"
                                Background="{DynamicResource Brush.Surface.Elevated}"
                                BorderBrush="{DynamicResource Brush.Divider}"
                                VerticalAlignment="Center"
                                Margin="8,0,0,0"
                                Visibility="Collapsed"
                                AutomationProperties.Name="Estimated figure">
                            <TextBlock x:Name="QualifierBadgeText"
                                       Text="ESTIMATED"
                                       Style="{StaticResource TextLabelStyle}"
                                       Foreground="{DynamicResource Brush.OnSurface.Dimmed}" />
                        </Border>
                    </StackPanel>

                    <!-- Figure + loading affordance share column 1; only one is visible.
                         G-08-2 — no right margin here; the 8 DIP pre-chip gap lives on
                         ChipBorder so it is outside DragRegion / SizeAll. -->
                    <Grid Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                        <!-- Display figure (terminal states). Live Ok/NearLimit hide this
                             and show QuotaBar instead (UIR-01 — no on-row percent). -->
                        <TextBlock x:Name="FigureText"
                                   Text="—"
                                   Style="{StaticResource TextDisplayStyle}"
                                   Foreground="{DynamicResource Brush.Accent}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Cursor="Arrow"
                                   AutomationProperties.LiveSetting="Polite" />

                        <!-- UIR-01 remaining-quota meter (3 DIP track/fill Borders).
                             Fill fraction is RemainingPct via star columns — not a
                             ProgressBar (RangeBase Maximum defaults to 1). -->
                        <Grid x:Name="QuotaBar"
                              Height="3"
                              MinWidth="36"
                              Visibility="Collapsed"
                              Cursor="Arrow"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="QuotaFillCol" Width="0*" />
                                <ColumnDefinition x:Name="QuotaEmptyCol" Width="100*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="QuotaTrack"
                                    Grid.ColumnSpan="2"
                                    Height="3"
                                    Background="{DynamicResource Brush.Divider}"
                                    CornerRadius="1" />
                            <Border x:Name="QuotaFill"
                                    Grid.Column="0"
                                    Height="3"
                                    Background="{DynamicResource Brush.Accent}"
                                    CornerRadius="1" />
                        </Grid>

                        <!-- WIDGET-03/loading — indeterminate ProgressBar replacing the
                             figure while a fetch is in-flight and no terminal reading
                             exists yet. Reduced-motion collapses this to the static glyph. -->
                        <ProgressBar x:Name="LoadingProgress"
                                     IsIndeterminate="True"
                                     Height="3"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Center"
                                     Visibility="Collapsed" />

                        <!-- Reduced-motion fallback (SystemParameters.ClientAreaAnimation == false):
                             a static "…" glyph in place of the animated ProgressBar. -->
                        <TextBlock x:Name="LoadingGlyph"
                                   Text="…"
                                   Style="{StaticResource TextDisplayStyle}"
                                   Foreground="{DynamicResource Brush.OnSurface.Dimmed}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Visibility="Collapsed" />
                    </Grid>
                </Grid>

                <!-- Window-type chip (outside DragRegion — clicking the chip never drags).
                     DATA-02/all-windows-tooltip — ToolTip is set imperatively from Render
                     to a StackPanel listing every parsed window. -->
                <Border x:Name="ChipBorder"
                        Grid.Column="1"
                        Background="{DynamicResource Brush.Surface.Elevated}"
                        BorderBrush="{DynamicResource Brush.Divider}"
                        BorderThickness="1"
                        CornerRadius="2"
                        Padding="6,4"
                        MinHeight="20"
                        Visibility="Collapsed"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Cursor="Arrow"
                        Margin="8,0,8,0">
                    <TextBlock x:Name="ChipText"
                               Text="5H"
                               Style="{StaticResource TextLabelStyle}"
                               Foreground="{DynamicResource Brush.OnSurface.Dimmed}"
                               HorizontalAlignment="Center"
                               TextWrapping="NoWrap" />
                </Border>

                <!-- Timestamp (outside DragRegion — clicking the timestamp never drags) -->
                <TextBlock x:Name="TimestampText"
                           Grid.Column="2"
                           Text=""
                           Style="{StaticResource TextLabelStyle}"
                           Foreground="{DynamicResource Brush.OnSurface.Dimmed}"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           Visibility="Collapsed" />
            </Grid>

            <!-- STALE / ERROR / NO KEY / RE-LOGIN / UNSUPPORTED state badge (kept
                 independent of the chip; collapsed by default). LiveSetting=Polite so
                 Narrator announces state transitions without interrupting. -->
            <Border x:Name="StateBadge"
                    Style="{StaticResource StateBadgeStyle}"
                    HorizontalAlignment="Left"
                    Margin="0,4,0,0"
                    Visibility="Collapsed"
                    AutomationProperties.LiveSetting="Polite">
                <TextBlock x:Name="StateBadgeText"
                           Text=""
                           Style="{StaticResource TextLabelStyle}"
                           Foreground="{DynamicResource Brush.OnSurface.Dimmed}" />
            </Border>
        </StackPanel>
    </Border>
</UserControl>
