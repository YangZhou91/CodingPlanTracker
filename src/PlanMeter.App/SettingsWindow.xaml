<Window x:Class="PlanMeter.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PlanMeter Settings"
        WindowStyle="None"
        Topmost="False"
        ShowInTaskbar="True"
        Width="360"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Surface}">

    <!-- PlanMeter B chrome (260915): custom title bar — token colors, compact close
         control, drag from title strip only. Owner still set by MainWindow.Settings_Click.
         Non-topmost, activatable; key management lives in the content body. -->
    <Border BorderBrush="{DynamicResource Brush.Divider}"
            BorderThickness="1"
            Background="{DynamicResource Brush.Surface}">
        <DockPanel LastChildFill="True">

            <Border DockPanel.Dock="Top"
                    Height="32"
                    Padding="12,0,6,0"
                    Background="{DynamicResource Brush.Surface}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="PlanMeter Settings"
                               Style="{StaticResource TextBodyStyle}"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Foreground="{DynamicResource Brush.OnSurface}"
                               VerticalAlignment="Center" />
                    <Button x:Name="CloseButton"
                            Grid.Column="1"
                            Width="28"
                            Height="28"
                            Margin="8,0,0,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="CloseButton_Click"
                            AutomationProperties.Name="Close settings"
                            ToolTip="Close">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                                        Background="Transparent"
                                        CornerRadius="4">
                                    <TextBlock Text="✕"
                                               FontSize="12"
                                               FontFamily="{StaticResource FontFamily.App}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.OnSurface.Dimmed}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Surface.Elevated}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <Border Padding="16">
                <StackPanel Orientation="Vertical">

                <TextBlock Text="Providers"
                           Style="{StaticResource TextBodyStyle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.OnSurface}"
                           Margin="0,0,0,8" />

                <StackPanel x:Name="CardsHost" Orientation="Vertical" />

                <Rectangle Height="{StaticResource Space.3Xl}" />

                <TextBlock Text="Polling"
                           Style="{StaticResource TextBodyStyle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.OnSurface}"
                           Margin="0,0,0,8" />

                <Border Background="{DynamicResource Brush.Surface.Elevated}"
                        BorderBrush="{DynamicResource Brush.Divider}"
                        BorderThickness="1"
                        CornerRadius="2"
                        Padding="12,8,12,8"
                        Margin="0,0,0,8">
                    <StackPanel Orientation="Vertical">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Polling interval"
                                       Style="{StaticResource TextBodyStyle}"
                                       Foreground="{DynamicResource Brush.OnSurface}"
                                       VerticalAlignment="Center" />
                            <ComboBox x:Name="IntervalCombo"
                                      Grid.Column="1"
                                      Width="96"
                                      VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="Changes take effect on the next scheduled poll."
                                   Style="{StaticResource TextBodyStyle}"
                                   Foreground="{DynamicResource Brush.OnSurface.Dimmed}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Rectangle Height="{StaticResource Space.3Xl}" />
                <TextBlock Text="Startup"
                           Style="{StaticResource TextBodyStyle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.OnSurface}"
                           Margin="0,0,0,8" />
                <Border Background="{DynamicResource Brush.Surface.Elevated}"
                        BorderBrush="{DynamicResource Brush.Divider}"
                        BorderThickness="1"
                        CornerRadius="2"
                        Padding="12,8,12,8"
                        Margin="0,0,0,8">
                    <StackPanel Orientation="Vertical">
                        <CheckBox x:Name="BootToggle"
                                  Content="Start with Windows"
                                  Foreground="{DynamicResource Brush.OnSurface}"
                                  AutomationProperties.Name="Start with Windows" />
                        <TextBlock Text="Starts PlanMeter when you sign in to Windows. If you move the app, uncheck and re-check to update the shortcut."
                                   Style="{StaticResource TextBodyStyle}"
                                   Foreground="{DynamicResource Brush.OnSurface.Dimmed}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Rectangle Height="{StaticResource Space.3Xl}" />
                <TextBlock Text="Appearance"
                           Style="{StaticResource TextBodyStyle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.OnSurface}"
                           Margin="0,0,0,8" />
                <Border Background="{DynamicResource Brush.Surface.Elevated}"
                        BorderBrush="{DynamicResource Brush.Divider}"
                        BorderThickness="1"
                        CornerRadius="2"
                        Padding="12,8,12,8"
                        Margin="0,0,0,8">
                    <StackPanel Orientation="Vertical">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Theme"
                                       Style="{StaticResource TextBodyStyle}"
                                       Foreground="{DynamicResource Brush.OnSurface}"
                                       VerticalAlignment="Center" />
                            <ComboBox x:Name="ThemeCombo"
                                      Grid.Column="1"
                                      Width="96"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="Theme" />
                        </Grid>
                        <TextBlock Text="Applies immediately. Saved for the next launch."
                                   Style="{StaticResource TextBodyStyle}"
                                   Foreground="{DynamicResource Brush.OnSurface.Dimmed}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="WindowErrorLine"
                           Text="Couldn't save settings. Changes won't survive a restart."
                           Style="{StaticResource TextBodyStyle}"
                           Foreground="{DynamicResource Brush.Error}"
                           TextWrapping="Wrap"
                           Margin="0,16,0,0"
                           Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </DockPanel>
    </Border>
</Window>
